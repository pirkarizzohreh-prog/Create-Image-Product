# Copy this file to .env and fill in real values before running
# `docker compose up`. Values here are safe local-dev defaults.

# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Bootstraps an admin user on first `seed_defaults` run (docker-compose
# entrypoint calls this automatically). Leave blank to skip.
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-strong-password

JWT_ACCESS_MIN=60
JWT_REFRESH_DAYS=7

# --- Database ---------------------------------------------------------------
POSTGRES_DB=pixelforge
POSTGRES_USER=pixelforge
POSTGRES_PASSWORD=pixelforge
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Host-side port for connecting a DB GUI tool (containers always use 5432
# internally). Change this if 5433 is also taken on your machine.
POSTGRES_HOST_PORT=5433

# --- Redis / Celery ---------------------------------------------------------
REDIS_URL=redis://redis:6379/0
# Host-side port only; change this if 6380 is also taken on your machine.
REDIS_HOST_PORT=6380

# --- Storage (S3-compatible: AWS S3 or Cloudflare R2) ------------------------
# STORAGE_BACKEND=local uses the container filesystem instead of S3/R2 -
# only for offline/local dev, never for production (no durability, no CDN,
# won't work with multiple backend/worker replicas).
STORAGE_BACKEND=local
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=pixelforge-media
# For Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_REGION=auto
S3_SIGNED_URL_TTL_SECONDS=3600
MEDIA_STORAGE_PREFIX=pixelforge

# --- AI Recreate Provider (Recreate Studio Mode) -----------------------------
# "noop" = passthrough, no external calls, works offline. "openai" requires
# OPENAI_API_KEY and calls the images/edits endpoint.
AI_RECREATE_PROVIDER=noop
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Pipeline seed defaults (only used the first time PipelineSettings is created) ---
DEFAULT_OUTPUT_SIZE_PX=2000
DEFAULT_PADDING_PERCENT=8.0
DEFAULT_OUTPUT_FORMAT=WEBP

# --- Email (review approve/reject notifications) -----------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@pixelforge.local

# --- Frontend -----------------------------------------------------------------
# Backend's host-side port defaults to 8001 (not 8000) so a fresh docker
# compose up doesn't collide with something else already using 8000 on your
# machine. If you change BACKEND_HOST_PORT below, update this URL to match -
# it's baked into the frontend build.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_HOST_PORT=8001
