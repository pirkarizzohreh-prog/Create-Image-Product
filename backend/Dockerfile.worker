# Same base image/deps as the API, but runs the Celery worker (and, via
# CMD override in docker-compose, beat) instead of gunicorn. Kept as a
# separate Dockerfile (rather than an entrypoint branch) so the image tag
# clearly communicates its role in `docker compose ps`.
FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libgl1 \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --upgrade pip setuptools wheel \
    && pip install -r requirements.txt

COPY . .
RUN chmod +x entrypoint-worker.sh

RUN useradd --create-home --shell /bin/bash appuser \
    && mkdir -p /app/media /home/appuser/.u2net \
    && chown -R appuser:appuser /app /home/appuser/.u2net
USER appuser
ENV HOME=/home/appuser

ENTRYPOINT ["./entrypoint-worker.sh"]
CMD ["celery", "-A", "config", "worker", "--loglevel=info", "--concurrency=2"]
